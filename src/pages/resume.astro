---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { RESUME } from "@consts"
---

<PageLayout title={RESUME.TITLE} description={RESUME.DESCRIPTION}>
  <TopLayout>
    <div class="animate flex items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
          Resume
        </h1>
        <div class="mt-1">
          {RESUME.DESCRIPTION}
        </div>
      </div>
      <button onclick="window.print()" class="shrink-0 mt-2 py-2 px-4 rounded text-sm border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 transition-colors print:hidden">
        Print / Save as PDF
      </button>
    </div>
  </TopLayout>
  <BottomLayout>
    <article class="animate prose prose-neutral dark:prose-invert max-w-none">
      <h2>Abdulmalik Ajisegiri</h2>
      <p>
        Model Risk & Validation Engineer · Dallas–Fort Worth, TX (DFW)<br />
        <a href="mailto:abdulmalikajisegiri@gmail.com">abdulmalikajisegiri@gmail.com</a> ·
        <a href="https://www.linkedin.com/in/malikajisegiri" target="_blank">linkedin.com/in/malikajisegiri</a> ·
        <a href="https://github.com/Maleek23" target="_blank">github.com/Maleek23</a>
      </p>

      <h2>Summary</h2>
      <p>
        Model-risk and cybersecurity engineer at DTCC, working across the
        AI/ML model-risk lifecycle — model identification, SR 11-7
        determination, and independent validation of models including LLMs and
        NLP systems. Previously embedded avionics R&D at Collins Aerospace
        (DO-178C) and enterprise cyber-risk at Deloitte (NIST CSF, incident
        response). CISA-certified; Python and SQL.
      </p>

      <h2>Technical skills</h2>
      <ul>
        <li><strong>Model risk & validation:</strong> SR 11-7 determination/classification, conceptual soundness review, backtesting, sensitivity analysis, benchmarking, challenger models, ongoing monitoring</li>
        <li><strong>AI/ML evaluation:</strong> LLM and NLP evaluation metrics, RAG pipelines, stress-testing, statistical benchmarks</li>
        <li><strong>Data & tooling:</strong> Python (pandas, NumPy, SciPy, scikit-learn), SQL, Power BI</li>
        <li><strong>Systems & MBSE:</strong> Cameo Systems Modeler, MATLAB/Simulink, SysML, requirements traceability, DO-178C verification & validation</li>
        <li><strong>Embedded:</strong> C++, event-driven test harnesses</li>
        <li><strong>Cyber:</strong> NIST CSF, control-gap assessment, incident response</li>
      </ul>

      <h2>Experience</h2>
      <h3>Model Risk & Validation Engineer — DTCC <span class="text-sm font-normal opacity-75">· Aug 2024 – Present</span></h3>
      <ul>
        <li>End-to-end model-risk lifecycle for AI/ML and quantitative models: identification, SR 11-7 determination/classification, and independent validation — backtesting, sensitivity analysis, benchmarking, challenger models.</li>
        <li>Resolved ~40% of pre-deployment issues through structured governance reviews.</li>
        <li>Built quantitative evaluation frameworks (SQL, Power BI, Python NLP metrics, stress-testing, statistical benchmarks) for production AI/ML (LLMs, RAG pipelines, NLP classifiers), improving review accuracy/completeness ~30%.</li>
      </ul>

      <h3>Graduate Teaching Assistant, Model-Based Systems Engineering — University of Oklahoma, Gallogly College of Engineering <span class="text-sm font-normal opacity-75">· Aug 2025 – May 2026</span></h3>
      <ul>
        <li>Led graduate labs for ISE 5893 (MBSE): Cameo Systems Modeler, MATLAB/Simulink, and Python for scenario/sensitivity analysis.</li>
        <li>Taught requirements traceability and lifecycle verification & validation.</li>
      </ul>

      <h3>Software Systems R&D Engineer — Collins Aerospace (RTX) <span class="text-sm font-normal opacity-75">· Aug 2023 – Aug 2024 · Secret clearance</span></h3>
      <ul>
        <li>Built an event-driven C++ test harness simulating 80+ RF command scenarios for embedded avionics, cutting development test cycles ~80%.</li>
        <li>Applied MBSE (Cameo, MATLAB/Simulink) across 300+ Jama requirements for DO-178C verification and HF frequency-control testing.</li>
      </ul>

      <h3>Cyber Risk Intern — Deloitte LLP <span class="text-sm font-normal opacity-75">· May 2022 – Aug 2023</span></h3>
      <ul>
        <li>Control-gap assessments and hardening of 5 REST APIs under NIST CSF.</li>
        <li>Incident-response planning across 50+ engineers.</li>
      </ul>

      <h2>Education</h2>
      <ul>
        <li><strong>University of Oklahoma</strong> — M.S. Systems Engineering (Advanced Analytics &amp; Model Metaheuristics), May 2026, GPA 3.7/4.0</li>
        <li><strong>UT Arlington</strong> — B.S. Computer Engineering, Minor in Mathematics</li>
      </ul>

      <h2>Certifications & memberships</h2>
      <ul>
        <li>CISA (ISACA)</li>
        <li>MATLAB Certified, Simulink Certified</li>
        <li>Member: NSBE, ISACA</li>
      </ul>

      <h2>Selected projects</h2>
      <ul>
        <li>
          <strong>Agentic AI Model Risk Management (MRM) Platform</strong> — 2026–Present.
          Automates the model-risk identification lifecycle: SR 11-7
          classification, artifact/memo generation, and pipeline tracking with
          SLA enforcement and audit trail.
        </li>
        <li>
          <strong><a href="https://quantedgelabs.net" target="_blank">QuantEdge Labs</a></strong> — Jan 2025–Present.
          End-to-end trading system with ML-calibrated probability scoring and
          simulation-based verification across 150+ daily opportunities.
        </li>
        <li>
          <strong><a href="https://github.com/Maleek23/cardiac-surgery-predictive-model" target="_blank">Clinical Risk Predictive Model — Cardiac Surgery Outcomes</a></strong> — 2025.
          Stacked ensemble, R² = 0.81, 20+ preoperative variables.
        </li>
      </ul>
    </article>
  </BottomLayout>
</PageLayout>

<style>
  @media print {
    header, footer, #drawer { display: none !important; }
    main { padding-top: 0 !important; }
  }
</style>
