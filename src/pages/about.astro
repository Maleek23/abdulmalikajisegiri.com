---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { ABOUT } from "@consts"

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "Abdulmalik Ajisegiri",
    "url": "https://abdulmalikajisegiri.com/about",
    "jobTitle": "Model Risk & Validation Engineer",
    "worksFor": { "@type": "Organization", "name": "DTCC" },
    "alumniOf": [
      { "@type": "EducationalOrganization", "name": "University of Oklahoma" },
      { "@type": "EducationalOrganization", "name": "UT Arlington" },
    ],
  },
}

const focusAreas = [
  { title: "Systems Engineering", href: "/systems-engineering", description: "Requirements, architecture, verification and validation across the lifecycle." },
  { title: "Model Risk & Validation", href: "/model-risk", description: "Conceptual soundness, backtesting, stress testing, and ongoing monitoring." },
  { title: "AI/ML", href: "/ai-ml", description: "ML model validation, governance for AI systems, reproducible machine learning." },
  { title: "MBSE", href: "/mbse", description: "SysML modeling, requirements traceability, model-based verification." },
]
---

<PageLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION} schema={profileSchema}>
  <TopLayout>
    <div class="animate">
      <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
        About Abdulmalik Ajisegiri
      </h1>
      <div class="mt-1">
        Model Risk & Validation Engineer · DTCC · Systems Engineering · AI/ML Governance · DFW, TX
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <article class="animate prose prose-neutral dark:prose-invert max-w-none">
      <p>
        Abdulmalik Ajisegiri is a model-risk and cybersecurity engineer at
        DTCC, working across the AI/ML model-risk lifecycle — model
        identification, SR 11-7 determination, and independent validation of
        models including LLMs and NLP systems. He is CISA-certified and works
        primarily in Python and SQL.
      </p>
      <p>
        Before DTCC, he did embedded avionics R&D at Collins Aerospace (RTX),
        building an event-driven C++ test harness for RF command scenarios and
        MBSE verification across 300+ requirements under DO-178C. Earlier, he
        worked in enterprise cyber-risk at Deloitte (NIST CSF, incident
        response), and he was a graduate teaching assistant for Model-Based
        Systems Engineering at the University of Oklahoma.
      </p>
      <p>
        His sharpest focus is <a href="/model-risk">model risk and validation</a>:
        interrogating a model's conceptual soundness before the numbers are run,
        stress-testing it against scenarios designed to break it, and monitoring
        it for decay once it is live. His <a href="/research">research notes</a>
        document that practice in the open.
      </p>

      <h2>Experience</h2>
      <ul>
        <li>
          <strong>Model Risk & Validation Engineer, DTCC</strong> — Aug 2024 – Present.
          End-to-end model-risk lifecycle for AI/ML and quantitative models:
          identification, SR 11-7 determination/classification, and independent
          validation (backtesting, sensitivity analysis, benchmarking, challenger
          models). Built quantitative evaluation frameworks (SQL, Power BI,
          Python NLP metrics, stress-testing, statistical benchmarks) for
          production AI/ML systems including LLMs, RAG pipelines, and NLP
          classifiers.
        </li>
        <li>
          <strong>Graduate Teaching Assistant, Model-Based Systems Engineering, University of Oklahoma</strong> — Aug 2025 – May 2026.
          Led graduate labs for ISE 5893 (MBSE): Cameo Systems Modeler,
          MATLAB/Simulink, and Python for scenario/sensitivity analysis;
          requirements traceability and lifecycle V&V.
        </li>
        <li>
          <strong>Software Systems R&D Engineer, Collins Aerospace (RTX)</strong> — Aug 2023 – Aug 2024.
          Event-driven C++ test harness simulating 80+ RF command scenarios for
          embedded avionics, cutting development test cycles ~80%. MBSE (Cameo,
          MATLAB/Simulink) across 300+ Jama requirements for DO-178C
          verification and HF frequency-control testing.
        </li>
        <li>
          <strong>Cyber Risk Intern, Deloitte LLP</strong> — May 2022 – Aug 2023.
          Control-gap assessments, hardening of 5 REST APIs (NIST CSF), and
          incident-response planning across 50+ engineers.
        </li>
      </ul>

      <h2>Education</h2>
      <ul>
        <li>
          <strong>University of Oklahoma</strong> — M.S. Systems Engineering
          (Advanced Analytics & Model Metaheuristics), May 2026, GPA 3.7/4.0
        </li>
        <li>
          <strong>UT Arlington</strong> — B.S. Computer Engineering, Minor in
          Mathematics
        </li>
      </ul>

      <h2>Certifications & memberships</h2>
      <ul>
        <li>CISA (ISACA)</li>
        <li>MATLAB Certified, Simulink Certified</li>
        <li>Member: NSBE, ISACA</li>
      </ul>

      <h2>Technical focus areas</h2>
      <div class="not-prose grid gap-4 sm:grid-cols-2 my-6">
        {focusAreas.map((area) => (
          <a href={area.href} class="group block p-4 rounded-lg border border-black/10 dark:border-white/20 hover:border-black/30 hover:dark:border-white/40 transition-colors duration-300">
            <div class="font-semibold text-black dark:text-white">{area.title}</div>
            <p class="text-sm mt-1 opacity-75">{area.description}</p>
          </a>
        ))}
      </div>

      <h2>Outside of work</h2>
      <p>
        Fitness, and photography and filmmaking under the
        <a href="/photography">Leekshotit</a> brand — a different kind of
        systems thinking, with light instead of models.
      </p>

      <div class="not-prose flex flex-wrap gap-4 mt-8">
        <a href="/resume" class="py-2 px-4 rounded text-sm bg-black dark:bg-white text-white dark:text-black hover:opacity-75 transition-opacity">
          View resume
        </a>
        <a href="/contact" class="py-2 px-4 rounded text-sm border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 transition-colors">
          Get in touch
        </a>
      </div>
    </article>
  </BottomLayout>
</PageLayout>
