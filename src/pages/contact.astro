---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { CONTACT, SOCIALS } from "@consts"
---

<PageLayout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>
  <TopLayout>
    <div class="animate">
      <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
        Contact
      </h1>
      <div class="mt-1">
        {CONTACT.DESCRIPTION}
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate max-w-none">
      <form id="contact-form" class="space-y-4 max-w-lg">
        <div>
          <label for="cf-name" class="block text-sm font-medium mb-1">Name</label>
          <input id="cf-name" name="name" type="text" required autocomplete="name"
            class="w-full rounded border border-black/20 dark:border-white/25 bg-transparent px-3 py-2 text-sm focus:outline-none focus:border-black/50 dark:focus:border-white/60" />
        </div>
        <div>
          <label for="cf-email" class="block text-sm font-medium mb-1">Email</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email"
            class="w-full rounded border border-black/20 dark:border-white/25 bg-transparent px-3 py-2 text-sm focus:outline-none focus:border-black/50 dark:focus:border-white/60" />
        </div>
        <div>
          <label for="cf-type" class="block text-sm font-medium mb-1">Inquiry type</label>
          <select id="cf-type" name="type"
            class="w-full rounded border border-black/20 dark:border-white/25 bg-white dark:bg-black px-3 py-2 text-sm focus:outline-none focus:border-black/50 dark:focus:border-white/60">
            <option>Engineering</option>
            <option>Quantitative</option>
            <option>Photography</option>
            <option>Other</option>
          </select>
        </div>
        <div>
          <label for="cf-message" class="block text-sm font-medium mb-1">Message</label>
          <textarea id="cf-message" name="message" rows="6" required
            class="w-full rounded border border-black/20 dark:border-white/25 bg-transparent px-3 py-2 text-sm focus:outline-none focus:border-black/50 dark:focus:border-white/60"></textarea>
        </div>
        <button type="submit"
          class="py-2 px-4 rounded text-sm bg-black dark:bg-white text-white dark:text-black hover:opacity-75 transition-opacity">
          Send message
        </button>
        <p class="text-xs opacity-60">This opens your email client with the message addressed to me — nothing is stored on this site.</p>
      </form>

      <div class="prose prose-neutral dark:prose-invert max-w-none mt-10">
        <h2>Direct</h2>
        <p>
          Email: <a href="mailto:me@abdulmalikajisegiri.com">me@abdulmalikajisegiri.com</a><br />
          GitHub: <a href="https://github.com/Maleek23" target="_blank">Maleek23</a>
        </p>
        <p>
          <em>Photography and film inquiries are best directed through
          <a href="https://leekshotit.com" target="_blank">Leekshotit</a>.</em>
        </p>
      </div>
    </div>
  </BottomLayout>
</PageLayout>

<script is:inline>
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault()
    const name = document.getElementById("cf-name").value
    const email = document.getElementById("cf-email").value
    const type = document.getElementById("cf-type").value
    const message = document.getElementById("cf-message").value
    const subject = encodeURIComponent(`[${type}] Inquiry from ${name}`)
    const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`)
    window.location.href = `mailto:me@abdulmalikajisegiri.com?subject=${subject}&body=${body}`
  })
</script>
