---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import { SITE, SOCIALS } from "@consts"

const posts = (await getCollection("research"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const readingTime = (body: string) => Math.max(1, Math.ceil(body.split(/\s+/).length / 200))

const thumbFor = (post: (typeof posts)[number]) =>
  post.slug === "stacking-ensembles-clinical-risk-modeling"
    ? "/research/stacking-ensembles-clinical-risk-modeling/stacking-architecture.png"
    : post.data.image

const stack = [
  "Python", "SQL", "C/C++", "TypeScript",
  "SR 11-7", "DO-178C", "NIST CSF",
  "MBSE / Cameo", "MATLAB / Simulink",
  "Docker", "AWS",
]

const stats = [
  { value: "4", label: "roles", sub: "DTCC · Collins · Deloitte · OU" },
  { value: "2", label: "degrees", sub: "M.S. OU · B.S. UT Arlington" },
  { value: "CISA", label: "certified", sub: "ISACA · MATLAB / Simulink" },
  { value: "20", label: "research notes", sub: "in the series, publishing weekly" },
]

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Abdulmalik Ajisegiri",
  "url": "https://abdulmalikajisegiri.com/",
}
---

<PageLayout
  title="Systems Engineering, Model Risk & AI/ML"
  description={SITE.DESCRIPTION}
  schema={websiteSchema}
>

  <!-- TERMINAL HERO -->
  <section style="padding: 72px 0 0;">
    <div class="ed-wrap">
      <p class="animate kicker" style="margin-bottom:10px;">$ finger abdulmalik</p>
      <h1 class="animate sec-title" style="font-size:clamp(38px,5vw,58px);">
        Abdulmalik Ajisegiri
      </h1>
      <p class="animate" style="font-family:var(--mono);font-size:13.5px;color:var(--muted);margin-top:12px;letter-spacing:.02em;">
        Model Risk &amp; Validation Engineer — DTCC · Dallas–Fort Worth, TX
      </p>

      <div class="animate term" style="margin-top:28px;">
        <div class="term-bar">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-title">abdulmalik@ajisegiri: ~</span>
        </div>
        <div class="term-body">
          <p><span class="term-prompt">$</span> whoami</p>
          <p class="term-dim">abdulmalik-ajisegiri — systems engineer, model validator</p>
          <p><span class="term-prompt">$</span> cat current_role.txt</p>
          <p class="term-dim">Model Risk &amp; Validation Engineer @ DTCC — SR 11-7, LLMs, challenger models</p>
          <p><span class="term-prompt">$</span> ls research/ | head -3</p>
          <p class="term-dim">validating-models-like-a-skeptic/ stacking-ensembles/ llm-evaluation-harness/</p>
          <p><span class="term-prompt">$</span> <span class="term-cursor">▊</span></p>
        </div>
      </div>

      <div class="animate" style="display:flex;flex-wrap:wrap;gap:12px;margin-top:28px;">
        <a href="/research" class="btn-solid">Read the research</a>
        <a href="/projects" class="btn-ghost">View projects</a>
        <a href="mailto:abdulmalikajisegiri@gmail.com" class="btn-ghost">Contact</a>
      </div>
    </div>
  </section>

  <!-- TECH STACK -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div class="kicker">01 / STACK &amp; STANDARDS</div>
      <h2 class="sec-title" style="margin-bottom:12px;">Tools of the trade.</h2>
      <p class="sec-sub" style="margin-bottom:28px;">The tools and frameworks I work in — from my resume, not a wish list.</p>
      <div style="display:flex;flex-wrap:wrap;gap:10px;">
        {stack.map((item) => (
          <span class="pill">{item.toUpperCase()}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div class="kicker">02 / BY THE NUMBERS</div>
      <h2 class="sec-title" style="margin-bottom:28px;">The record so far.</h2>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;" class="stats-grid">
        {stats.map((s) => (
          <div class="note-card" style="padding:22px 20px;text-align:left;min-height:0;">
            <p style="font-family:var(--mono);font-size:24px;font-weight:500;color:var(--ink);">{s.value}</p>
            <p style="font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;color:var(--green);margin-top:8px;">{s.label.toUpperCase()}</p>
            <p style="font-size:12px;color:var(--faint);margin-top:6px;line-height:1.5;">{s.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURED RESEARCH -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:28px;">
        <div>
          <div class="kicker">03 / FEATURED RESEARCH</div>
          <h2 class="sec-title">Notes from the bench.</h2>
        </div>
        <a href="/research" class="note-link" style="margin-top:0;">All research notes &rarr;</a>
      </div>
      <div style="display:grid;grid-template-columns:1fr;gap:20px;">
        {posts.map((post) => (
          <a href={`/research/${post.slug}`} class="note-card" style="text-decoration:none;padding:0;overflow:hidden;">
            <div style="aspect-ratio:2/1;width:100%;overflow:hidden;background:var(--green-soft);">
              <img src={thumbFor(post)} alt={post.data.title} loading="lazy"
                style="width:100%;height:100%;object-fit:cover;object-position:top;display:block;" />
            </div>
            <div style="padding:26px 28px;">
              <div class="note-meta"><span>RESEARCH NOTE</span><span>{readingTime(post.body)} MIN READ</span></div>
              <h3>{post.data.title}</h3>
              <p>{post.data.summary}</p>
              <span class="note-link">Read the article &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CODE SHOWCASE -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div class="kicker">04 / FROM THE WORKBENCH</div>
      <h2 class="sec-title" style="margin-bottom:12px;">Drift, quantified.</h2>
      <p class="sec-sub" style="margin-bottom:28px;max-width:640px;">
        Population Stability Index — the drift monitor from
        <a href="/research/validating-models-like-a-skeptic" style="color:var(--green);">Validating Models Like a Skeptic</a>.
        Bin on the reference distribution, watch the score most of all.
      </p>
      <div class="code-panel">
        <div class="code-panel-bar">
          <span>psi_monitor.py</span>
          <span>python</span>
        </div>
        <pre><code><span style="color:#c792ea">def</span> <span style="color:#82aaff">psi</span>(expected, actual, bins=<span style="color:#f78c6c">10</span>, eps=<span style="color:#f78c6c">1e-4</span>):
    <span style="color:#636d83">"""Population Stability Index.
    &lt;0.1 stable · 0.1–0.25 watch · &gt;0.25 investigate."""</span>
    breaks = np.unique(np.quantile(expected, np.linspace(<span style="color:#f78c6c">0</span>, <span style="color:#f78c6c">1</span>, bins + <span style="color:#f78c6c">1</span>)))
    e_counts, _ = np.histogram(expected, bins=breaks)
    a_counts, _ = np.histogram(actual, bins=breaks)
    e_perc = np.clip(e_counts / e_counts.sum(), eps, <span style="color:#c792ea">None</span>)
    a_perc = np.clip(a_counts / a_counts.sum(), eps, <span style="color:#c792ea">None</span>)
    <span style="color:#c792ea">return</span> np.sum((a_perc - e_perc) * np.log(a_perc / e_perc))

<span style="color:#636d83"># score drift is the canary: decisions move when scores move</span>
<span style="color:#82aaff">print</span>(<span style="color:#c3e88d">f"model score  PSI=</span><span style="color:#c3e88d">{</span>psi(score_valid, score_prod):.3f<span style="color:#c3e88d">}</span><span style="color:#c3e88d">"</span>)</code></pre>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:28px;">
        <div>
          <div class="kicker">05 / CASE STUDIES</div>
          <h2 class="sec-title">Built, not theorized.</h2>
        </div>
        <a href="/projects" class="note-link" style="margin-top:0;">All projects &rarr;</a>
      </div>
      <div style="display:grid;grid-template-columns:1fr;gap:20px;">
        {projects.map((project) => (
          <ArrowCard entry={project} pill={true} />
        ))}
      </div>
    </div>
  </section>

  <!-- CURRENTLY -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div class="kicker">06 / CURRENTLY</div>
      <h2 class="sec-title" style="margin-bottom:28px;">Right now.</h2>
      <div class="note-card">
        <div class="note-meta"><span>STATUS</span><span>DALLAS–FORT WORTH, TX</span></div>
        <p style="font-size:16px;line-height:1.7;color:var(--ink);">
          <b>Model Risk &amp; Validation Engineer</b> at DTCC, working the AI/ML model-risk lifecycle —
          SR 11-7 determination, independent validation, LLM evaluation. Based in Dallas–Fort Worth, TX.
          Writing a 20-note series on validation, quant research, simulation, and embedded systems.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:24px;">
          <a href="/about" class="btn-solid">About me</a>
          <a href="/resume" class="btn-ghost">Resume</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PROFILES -->
  <section class="ed-block animate" style="border-bottom:none;">
    <div class="ed-wrap">
      <div class="kicker">07 / ELSEWHERE</div>
      <h2 class="sec-title" style="margin-bottom:12px;">Find me elsewhere.</h2>
      <p class="sec-sub" style="margin-bottom:28px;">Code, writing, and professional profiles.</p>
      <div class="note-card" style="gap:14px;">
        {SOCIALS.map(social => (
          <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:12px 0;border-bottom:1px solid var(--line);">
            <span style="font-family:var(--mono);font-size:12px;letter-spacing:.14em;color:var(--muted);">{social.NAME.toUpperCase()}</span>
            <a href={social.HREF} target="_blank" rel="noopener" class="note-link" style="margin-top:0;">{social.TEXT} &rarr;</a>
          </div>
        ))}
        <div style="margin-top:8px;">
          <a href="mailto:abdulmalikajisegiri@gmail.com" class="btn-solid">abdulmalikajisegiri@gmail.com</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    @media (max-width: 640px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
  </style>
</PageLayout>
