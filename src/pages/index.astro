---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import { formatDate } from "@lib/utils"
import { SITE, SOCIALS } from "@consts"

const posts = (await getCollection("research"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,6)

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const readingTime = (body: string) => Math.max(1, Math.ceil(body.split(/\s+/).length / 200))

const stack = [
  "Python", "SQL", "C/C++", "TypeScript",
  "SR 11-7", "DO-178C", "NIST CSF",
  "MBSE / Cameo", "MATLAB / Simulink",
  "Docker", "AWS",
]

const stats = [
  { value: "4", label: "roles", sub: "DTCC · Collins · Deloitte · OU" },
  { value: "2", label: "degrees", sub: "M.S. OU · B.S. UT Arlington" },
  { value: "CISA", label: "certified", sub: "ISACA · MATLAB / Simulink" },
  { value: "20", label: "research notes", sub: "the working library, publishing weekly" },
]

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Abdulmalik Ajisegiri",
  "url": "https://abdulmalikajisegiri.com/",
}
---

<PageLayout
  title="Systems Engineering, Model Risk & AI/ML"
  description={SITE.DESCRIPTION}
  schema={websiteSchema}
>

  <!-- TERMINAL HERO -->
  <section style="padding: 72px 0 0;">
    <div class="ed-wrap">
      <p class="animate kicker" style="margin-bottom:10px;">$ finger abdulmalik</p>
      <h1 class="animate sec-title" style="font-size:clamp(38px,5vw,58px);">
        Abdulmalik Ajisegiri
      </h1>
      <p class="animate" style="font-family:var(--mono);font-size:13.5px;color:var(--muted);margin-top:12px;letter-spacing:.02em;">
        Model Risk &amp; Validation Engineer — DTCC · Dallas–Fort Worth, TX
      </p>

      <div class="animate term" style="margin-top:28px;">
        <div class="term-bar">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-title">abdulmalik@ajisegiri: ~</span>
        </div>
        <div class="term-body">
          <p><span class="term-prompt">$</span> whoami</p>
          <p class="term-dim">abdulmalik-ajisegiri — systems engineer, model validator</p>
          <p><span class="term-prompt">$</span> cat current_role.txt</p>
          <p class="term-dim">Model Risk &amp; Validation Engineer @ DTCC — SR 11-7, LLMs, challenger models</p>
          <p><span class="term-prompt">$</span> ls projects/ | head -3</p>
          <p class="term-dim">agentic-mrm-platform/ quantedge-labs/ cardiac-surgery-risk-model/</p>
          <p><span class="term-prompt">$</span> <span class="term-cursor">▊</span></p>
        </div>
      </div>

      <div class="animate" style="display:flex;flex-wrap:wrap;gap:12px;margin-top:28px;">
        <a href="/projects" class="btn-solid">View selected work</a>
        <a href="/research" class="btn-ghost">Browse the library</a>
        <a href="mailto:abdulmalikajisegiri@gmail.com" class="btn-ghost">Contact</a>
      </div>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:28px;">
        <div>
          <div class="kicker">01 / SELECTED WORK</div>
          <h2 class="sec-title">Built, not theorized.</h2>
          <p class="sec-sub" style="margin-top:10px;max-width:640px;">Case studies and platforms — the work the research notes come from.</p>
        </div>
        <a href="/projects" class="note-link" style="margin-top:0;">All projects &rarr;</a>
      </div>
      <div style="display:grid;grid-template-columns:1fr;gap:20px;">
        {projects.map((project) => (
          <ArrowCard entry={project} pill={true} />
        ))}
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div class="kicker">02 / BY THE NUMBERS</div>
      <h2 class="sec-title" style="margin-bottom:28px;">The record so far.</h2>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;" class="stats-grid">
        {stats.map((s) => (
          <div class="note-card" style="padding:22px 20px;text-align:left;min-height:0;">
            <p style="font-family:var(--mono);font-size:24px;font-weight:500;color:var(--ink);">{s.value}</p>
            <p style="font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;color:var(--green);margin-top:8px;">{s.label.toUpperCase()}</p>
            <p style="font-size:12px;color:var(--faint);margin-top:6px;line-height:1.5;">{s.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TECH STACK -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div class="kicker">03 / STACK &amp; STANDARDS</div>
      <h2 class="sec-title" style="margin-bottom:12px;">Tools of the trade.</h2>
      <p class="sec-sub" style="margin-bottom:28px;">The tools and frameworks I work in — from my resume, not a wish list.</p>
      <div style="display:flex;flex-wrap:wrap;gap:10px;">
        {stack.map((item) => (
          <span class="pill">{item.toUpperCase()}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- CODE SHOWCASE -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div class="kicker">04 / FROM THE WORKBENCH</div>
      <h2 class="sec-title" style="margin-bottom:12px;">Drift, quantified.</h2>
      <p class="sec-sub" style="margin-bottom:28px;max-width:640px;">
        Population Stability Index — the drift monitor from
        <a href="/research/validating-models-like-a-skeptic" style="color:var(--green);">Validating Models Like a Skeptic</a>.
        Bin on the reference distribution, watch the score most of all.
      </p>
      <div class="code-panel">
        <div class="code-panel-bar">
          <span>psi_monitor.py</span>
          <span>python</span>
        </div>
        <pre><code><span style="color:#c792ea">def</span> <span style="color:#82aaff">psi</span>(expected, actual, bins=<span style="color:#f78c6c">10</span>, eps=<span style="color:#f78c6c">1e-4</span>):
    <span style="color:#636d83">"""Population Stability Index.
    &lt;0.1 stable · 0.1–0.25 watch · &gt;0.25 investigate."""</span>
    breaks = np.unique(np.quantile(expected, np.linspace(<span style="color:#f78c6c">0</span>, <span style="color:#f78c6c">1</span>, bins + <span style="color:#f78c6c">1</span>)))
    e_counts, _ = np.histogram(expected, bins=breaks)
    a_counts, _ = np.histogram(actual, bins=breaks)
    e_perc = np.clip(e_counts / e_counts.sum(), eps, <span style="color:#c792ea">None</span>)
    a_perc = np.clip(a_counts / a_counts.sum(), eps, <span style="color:#c792ea">None</span>)
    <span style="color:#c792ea">return</span> np.sum((a_perc - e_perc) * np.log(a_perc / e_perc))

<span style="color:#636d83"># score drift is the canary: decisions move when scores move</span>
<span style="color:#82aaff">print</span>(<span style="color:#c3e88d">f"model score  PSI=</span><span style="color:#c3e88d">{</span>psi(score_valid, score_prod):.3f<span style="color:#c3e88d">}</span><span style="color:#c3e88d">"</span>)</code></pre>
      </div>
    </div>
  </section>

  <!-- LIBRARY -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap;margin-bottom:8px;">
        <div>
          <div class="kicker">05 / THE LIBRARY</div>
          <h2 class="sec-title">Notes from the bench.</h2>
          <p class="sec-sub" style="margin-top:10px;max-width:640px;">Twenty research notes on validation, quant research, simulation, and embedded systems — the working library behind the case studies.</p>
        </div>
        <a href="/research" class="note-link" style="margin-top:0;">Browse all 20 notes &rarr;</a>
      </div>
      <div class="lib-index">
        {posts.map((post) => (
          <a href={`/research/${post.slug}`} class="lib-row">
            <div class="lib-row-main">
              <h3>{post.data.title}</h3>
              <div class="lib-row-meta">
                <span>{formatDate(post.data.date).toUpperCase()}</span>
                <span>{readingTime(post.body)} MIN READ</span>
                <span>{post.data.tags.slice(0, 2).join(" · ").toUpperCase()}</span>
              </div>
            </div>
            <span class="lib-row-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CURRENTLY -->
  <section class="ed-block animate">
    <div class="ed-wrap">
      <div class="kicker">06 / CURRENTLY</div>
      <h2 class="sec-title" style="margin-bottom:28px;">Right now.</h2>
      <div class="note-card">
        <div class="note-meta"><span>STATUS</span><span>DALLAS–FORT WORTH, TX</span></div>
        <p style="font-size:16px;line-height:1.7;color:var(--ink);">
          <b>Model Risk &amp; Validation Engineer</b> at DTCC, working the AI/ML model-risk lifecycle —
          SR 11-7 determination, independent validation, LLM evaluation. Based in Dallas–Fort Worth, TX.
          Building an agentic model-risk platform and writing a 20-note research series on validation, quant research, simulation, and embedded systems.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:24px;">
          <a href="/about" class="btn-solid">About me</a>
          <a href="/resume" class="btn-ghost">Resume</a>
        </div>
      </div>
    </div>
  </section>

  <!-- PROFILES -->
  <section class="ed-block animate" style="border-bottom:none;">
    <div class="ed-wrap">
      <div class="kicker">07 / ELSEWHERE</div>
      <h2 class="sec-title" style="margin-bottom:12px;">Find me elsewhere.</h2>
      <p class="sec-sub" style="margin-bottom:28px;">Code, writing, and professional profiles.</p>
      <div class="note-card" style="gap:14px;">
        {SOCIALS.map(social => (
          <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:12px 0;border-bottom:1px solid var(--line);">
            <span style="font-family:var(--mono);font-size:12px;letter-spacing:.14em;color:var(--muted);">{social.NAME.toUpperCase()}</span>
            <a href={social.HREF} target="_blank" rel="noopener" class="note-link" style="margin-top:0;">{social.TEXT} &rarr;</a>
          </div>
        ))}
        <div style="margin-top:8px;">
          <a href="mailto:abdulmalikajisegiri@gmail.com" class="btn-solid">abdulmalikajisegiri@gmail.com</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    @media (max-width: 640px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr) !important; }
    }
    .lib-index { border-top: 1px solid var(--line); margin-top: 20px; }
    .lib-row {
      display: flex; align-items: center; justify-content: space-between;
      gap: 20px; padding: 18px 12px; border-bottom: 1px solid var(--line);
      text-decoration: none; transition: background .15s ease;
    }
    .lib-row:hover { background: var(--green-soft); }
    .lib-row-main h3 {
      font-family: var(--serif); font-size: 19px; font-weight: 600;
      line-height: 1.35; color: var(--ink); margin: 0 0 6px;
    }
    .lib-row-meta {
      display: flex; flex-wrap: wrap; gap: 8px 14px;
      font-family: var(--mono); font-size: 10.5px;
      letter-spacing: .12em; color: var(--muted);
    }
    .lib-row-arrow { font-size: 20px; color: var(--green); flex-shrink: 0; }
    /* Interactive terminal prompt — same height as the static cursor line it replaces */
    .term-active { position: relative; display: flex; align-items: baseline; min-height: 1.9em; }
    .term-active .term-cursor { visibility: hidden; }
    .term-active.is-focused .term-cursor { visibility: visible; }
    .term-typed { white-space: pre-wrap; overflow-wrap: anywhere; color: var(--panel-ink); }
    .term-kb {
      position: absolute; inset: 0; width: 100%; height: 100%;
      opacity: 0; border: 0; padding: 0; margin: 0;
      font-size: 16px; /* stops iOS auto-zoom on focus */
      background: transparent; color: transparent; caret-color: transparent;
    }
  </style>

  <script is:inline>
  /* Interactive hero terminal — progressive enhancement.
     No JS: the static transcript above renders exactly as before.
     With JS: the trailing "$ ▊" line becomes a live prompt. */
  (function () {
    'use strict';
    var term = document.querySelector('.term');
    if (!term) return;
    var body = term.querySelector('.term-body');
    if (!body || !body.lastElementChild) return;

    /* Real slugs, hardcoded from src/content (verified published). */
    var PROJECT_URLS = {
      'agentic-mrm-platform': '/projects/agentic-mrm-platform/',
      'quantedge-labs': '/projects/quantedge-labs/',
      'cardiac-surgery-risk-model': '/projects/cardiac-surgery-risk-model/'
    };
    var RESEARCH_SLUGS = [
      'validating-models-like-a-skeptic',
      'stacking-ensembles-clinical-risk-modeling',
      'llm-evaluation-harness-bleu-rouge-sbert',
      'when-r2-lies-regression-evaluation',
      'survivorship-bias-lookahead-backtest-killers',
      'how-system-calls-work-tiny-c-kernel',
      'discrete-event-simulation-experiment-design',
      'angle-of-arrival-embedded-audio-localization',
      'automated-code-review-pipeline',
      'dma-double-buffering-sensor-capture',
      'monte-carlo-decisions-under-uncertainty',
      'zod-at-the-boundary-api-validation',
      'low-power-embedded-design-tm4c123',
      'optimization-metaheuristics-decisions',
      'mbse-requirements-traceability',
      'backtesting-without-fooling-yourself',
      'detecting-model-decay-monitoring',
      'stress-testing-scenario-analysis',
      'verification-validation-systems-lifecycle',
      'requirements-engineering-complex-systems'
    ];
    var QUIPS = [
      "try 'help'",
      "nope. try 'help'",
      "the terminal judges you silently. try 'help'"
    ];
    var quipIdx = 0;
    var history = [];
    var histIdx = 0;
    var active = null;

    function el(tag, cls, text) {
      var n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined && text !== null) n.textContent = text;
      return n;
    }

    function print(text, cls) {
      body.appendChild(el('p', cls || 'term-dim', text));
    }

    function echoCmd(cmd) {
      var p = el('p');
      p.appendChild(el('span', 'term-prompt', '$'));
      p.appendChild(document.createTextNode(' ' + cmd));
      body.appendChild(p);
    }

    function makePrompt() {
      var wrap = el('div', 'term-active');
      wrap.appendChild(el('span', 'term-prompt', '$'));
      wrap.appendChild(document.createTextNode(' '));
      var typed = el('span', 'term-typed', '');
      var cursor = el('span', 'term-cursor', '▊');
      var input = el('input', 'term-kb');
      input.setAttribute('type', 'text');
      input.setAttribute('autocomplete', 'off');
      input.setAttribute('autocapitalize', 'off');
      input.setAttribute('autocorrect', 'off');
      input.setAttribute('spellcheck', 'false');
      input.setAttribute('aria-label', 'Terminal input. Type help for a list of commands.');
      wrap.appendChild(typed);
      wrap.appendChild(cursor);
      wrap.appendChild(input);
      body.appendChild(wrap);

      input.addEventListener('focus', function () { wrap.classList.add('is-focused'); });
      input.addEventListener('blur', function () { wrap.classList.remove('is-focused'); });
      input.addEventListener('input', function () { typed.textContent = input.value; });
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          submit(input.value);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          moveHist(-1);
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          moveHist(1);
        }
      });
      active = { wrap: wrap, input: input, typed: typed };
    }

    function moveHist(d) {
      if (!history.length || !active) return;
      histIdx = Math.min(history.length, Math.max(0, histIdx + d));
      var v = histIdx < history.length ? history[histIdx] : '';
      active.input.value = v;
      active.typed.textContent = v;
    }

    function submit(raw) {
      var cmd = raw.trim();
      var wasFocused = active && document.activeElement === active.input;
      body.removeChild(active.wrap);
      if (cmd) {
        echoCmd(cmd);
      } else {
        var p = el('p');
        p.appendChild(el('span', 'term-prompt', '$'));
        body.appendChild(p);
      }
      if (cmd) {
        history.push(cmd);
        histIdx = history.length;
        run(cmd);
      }
      makePrompt();
      /* Keep the keyboard up on mobile / keep typing on desktop. */
      if (wasFocused && active) active.input.focus();
    }

    function doOpen(q) {
      q = (q || '').trim().toLowerCase();
      if (!q) { print("usage: open <name>   (e.g. open quantedge)"); return; }
      var matches = [];
      Object.keys(PROJECT_URLS).forEach(function (s) {
        if (s.indexOf(q) !== -1) matches.push([PROJECT_URLS[s], s]);
      });
      RESEARCH_SLUGS.forEach(function (s) {
        if (s.indexOf(q) !== -1) matches.push(['/research/' + s + '/', s]);
      });
      if (matches.length === 1) {
        print('opening ' + matches[0][0] + ' …');
        var url = matches[0][0];
        setTimeout(function () { window.location.href = url; }, 650);
      } else if (matches.length > 1) {
        print('multiple matches — be more specific:');
        matches.slice(0, 8).forEach(function (m) { print('  ' + m[1]); });
      } else {
        print("no match for '" + q + "' — try 'ls projects/' or 'ls research/'");
      }
    }

    function run(cmd) {
      var parts = cmd.split(/\s+/);
      var verb = parts[0].toLowerCase();
      var arg = parts.slice(1).join(' ').toLowerCase();

      if (verb === 'help') {
        print('available commands:');
        print('  help               show this help');
        print('  whoami             who is this guy');
        print('  ls                 list sections');
        print('  ls projects/       list case studies');
        print('  ls research/       list research notes');
        print('  open <name>        open a project or note (fuzzy match)');
        print('  contact            get in touch');
        print('  hire               why you should hire this guy');
        print('  clear              clear the terminal');
      } else if (verb === 'whoami') {
        print('abdulmalik-ajisegiri — systems engineer, model validator');
      } else if (verb === 'cat' && arg === 'current_role.txt') {
        print('Model Risk & Validation Engineer @ DTCC — SR 11-7, LLMs, challenger models');
      } else if (verb === 'ls' && !arg) {
        print('projects/  research/  about  resume  contact');
      } else if (verb === 'ls' && (arg === 'projects' || arg === 'projects/')) {
        print(Object.keys(PROJECT_URLS).map(function (s) { return s + '/'; }).join('  '));
      } else if (verb === 'ls' && (arg === 'research' || arg === 'research/')) {
        print(RESEARCH_SLUGS.join('  '));
      } else if (verb === 'open') {
        doOpen(arg);
      } else if (verb === 'hire' || verb === 'recruit') {
        print('Abdulmalik Ajisegiri — Model Risk & Validation Engineer @ DTCC.');
        print('SR 11-7, LLM evaluation, MBSE. M.S. Systems Engineering (OU, 3.7). CISA. DFW, TX.');
        print('→ /hire for the 60-second version');
        print('→ abdulmalikajisegiri@gmail.com');
      } else if (verb === 'contact') {
        print('opening mail client …');
        setTimeout(function () { window.location.href = 'mailto:abdulmalikajisegiri@gmail.com'; }, 600);
      } else if (verb === 'clear') {
        body.innerHTML = '';
      } else {
        print('command not found: ' + parts[0] + ' — ' + QUIPS[quipIdx % QUIPS.length]);
        quipIdx++;
      }
    }

    /* Swap the static "$ ▊" line for the live prompt — same height, no layout shift. */
    body.removeChild(body.lastElementChild);
    makePrompt();

    /* Tapping anywhere on the terminal focuses it (opens the native keyboard on mobile). */
    term.addEventListener('click', function () {
      if (active) active.input.focus();
    });
  })();
  </script>
</PageLayout>
