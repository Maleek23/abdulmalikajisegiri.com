---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import { SITE, SOCIALS } from "@consts"

const posts = (await getCollection("research"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0,3)

const readingTime = (body: string) => Math.max(1, Math.ceil(body.split(/\s+/).length / 200))

const thumbFor = (post: (typeof posts)[number]) =>
  post.slug === "stacking-ensembles-clinical-risk-modeling"
    ? "/research/stacking-ensembles-clinical-risk-modeling/stacking-architecture.png"
    : post.data.image

const stack = [
  "Python", "SQL", "C/C++", "TypeScript",
  "SR 11-7", "DO-178C", "NIST CSF",
  "MBSE / Cameo", "MATLAB / Simulink",
  "Docker", "AWS",
]

const stats = [
  { value: "4", label: "roles", sub: "DTCC · Collins · Deloitte · OU" },
  { value: "2", label: "degrees", sub: "M.S. OU · B.S. UT Arlington" },
  { value: "CISA", label: "certified", sub: "ISACA · MATLAB / Simulink" },
  { value: "20", label: "research notes", sub: "in the series, publishing weekly" },
]

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Abdulmalik Ajisegiri",
  "url": "https://abdulmalikajisegiri.com/",
}
---

<PageLayout
  title="Systems Engineering, Model Risk & AI/ML"
  description={SITE.DESCRIPTION}
  schema={websiteSchema}
>

  <!-- Light Mode: Particles -->
  <div class='absolute inset-0 block dark:hidden'>
    <div id='particles1' class='fixed inset-0'></div>
    <div id='particles2' class='fixed inset-0'></div>
    <div id='particles3' class='fixed inset-0'></div>
  </div>

  <!-- Dark Theme: Stars -->
  <div class='absolute inset-0 bg-black hidden dark:block'>
    <div id='stars1' class='fixed inset-0'></div>
    <div id='stars2' class='fixed inset-0'></div>
    <div id='stars3' class='fixed inset-0'></div>
  </div>

  <script is:inline src="/js/bg.js"></script>

  <style>
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    .term-cursor { animation: blink 1.1s step-end infinite; }
  </style>

  <!-- TERMINAL HERO -->
  <section class="relative w-full px-5 pt-24 md:pt-32 pb-10">
    <div class="mx-auto max-w-screen-sm">
      <p class="animate text-sm font-mono opacity-60 mb-3">$ finger abdulmalik</p>
      <h1 class="animate text-3xl md:text-4xl lg:text-5xl font-bold text-black dark:text-white">
        Abdulmalik Ajisegiri
      </h1>
      <p class="animate text-sm md:text-base opacity-75 mt-2 font-mono">
        Model Risk &amp; Validation Engineer — DTCC · Dallas–Fort Worth, TX
      </p>

      <div class="animate mt-6 rounded-xl border border-black/15 dark:border-white/20 bg-black/[0.03] dark:bg-white/[0.04] overflow-hidden">
        <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-black/10 dark:border-white/10">
          <span class="w-2.5 h-2.5 rounded-full bg-black/15 dark:bg-white/25"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-black/15 dark:bg-white/25"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-black/15 dark:bg-white/25"></span>
          <span class="ml-2 text-xs font-mono opacity-50">abdulmalik@ajisegiri: ~</span>
        </div>
        <div class="p-5 font-mono text-[13px] md:text-sm leading-7 text-black dark:text-white">
          <p><span class="text-green-700 dark:text-green-400 font-semibold">$</span> whoami</p>
          <p class="opacity-80">abdulmalik-ajisegiri — systems engineer, model validator</p>
          <p><span class="text-green-700 dark:text-green-400 font-semibold">$</span> cat current_role.txt</p>
          <p class="opacity-80">Model Risk &amp; Validation Engineer @ DTCC — SR 11-7, LLMs, challenger models</p>
          <p><span class="text-green-700 dark:text-green-400 font-semibold">$</span> ls research/ | head -3</p>
          <p class="opacity-80">validating-models-like-a-skeptic/ stacking-ensembles/ llm-evaluation-harness/</p>
          <p><span class="text-green-700 dark:text-green-400 font-semibold">$</span> <span class="term-cursor">▊</span></p>
        </div>
      </div>

      <div class="animate flex flex-wrap gap-3 mt-6">
        <a href="/research" class="py-2 px-4 rounded truncate text-sm bg-black dark:bg-white text-white dark:text-black hover:opacity-75 blend">
          Read the research
        </a>
        <a href="/projects" class="py-2 px-4 truncate rounded text-sm border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend">
          View projects
        </a>
        <a href="mailto:abdulmalikajisegiri@gmail.com" class="py-2 px-4 truncate rounded text-sm border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend">
          Contact
        </a>
      </div>
    </div>
  </section>

  <div class="relative bg-white dark:bg-black">
    <div class="mx-auto max-w-screen-sm p-5 space-y-20 pb-16">

      <!-- TECH STACK -->
      <section class="animate">
        <p class="font-semibold text-black dark:text-white mb-1">Stack &amp; standards</p>
        <p class="text-sm opacity-75 mb-4">The tools and frameworks I work in — from my resume, not a wish list.</p>
        <div class="flex flex-wrap gap-2">
          {stack.map((item) => (
            <span class="font-mono text-xs px-3 py-1.5 rounded-md border border-black/15 dark:border-white/20 bg-black/[0.03] dark:bg-white/[0.05] text-black/80 dark:text-white/80">
              {item}
            </span>
          ))}
        </div>
      </section>

      <!-- STATS -->
      <section class="animate">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          {stats.map((s) => (
            <div class="p-4 rounded-lg border border-black/10 dark:border-white/20 text-center">
              <p class="font-mono text-xl md:text-2xl font-bold text-black dark:text-white">{s.value}</p>
              <p class="text-xs uppercase tracking-wide opacity-75 mt-1">{s.label}</p>
              <p class="text-[11px] opacity-50 mt-1 leading-tight">{s.sub}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- FEATURED RESEARCH -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between items-baseline">
            <p class="font-semibold text-black dark:text-white">Featured research</p>
            <a href="/research" class="group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend text-sm">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">All research notes</span>
            </a>
          </div>
          <ul class="space-y-5">
            {posts.map((post) => (
              <li>
                <a href={`/research/${post.slug}`} class="group block rounded-xl border border-black/10 dark:border-white/20 overflow-hidden hover:border-black/30 hover:dark:border-white/40 transition-colors duration-300">
                  <div class="aspect-[2/1] w-full overflow-hidden bg-black/5 dark:bg-white/5">
                    <img src={thumbFor(post)} alt={post.data.title} loading="lazy"
                      class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-500" />
                  </div>
                  <div class="p-4">
                    <p class="font-mono text-[11px] uppercase opacity-50">{readingTime(post.body)} min read</p>
                    <p class="font-semibold mt-1 text-black dark:text-white line-clamp-2">{post.data.title}</p>
                    <p class="text-sm mt-1 opacity-75 line-clamp-2">{post.data.summary}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- CODE SHOWCASE -->
      <section class="animate">
        <div class="space-y-3">
          <p class="font-semibold text-black dark:text-white">From the workbench</p>
          <p class="text-sm opacity-75">
            Population Stability Index — the drift monitor from
            <a href="/research/validating-models-like-a-skeptic" class="underline underline-offset-2 decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white">Validating Models Like a Skeptic</a>.
            Bin on the reference distribution, watch the score most of all.
          </p>
          <div class="rounded-xl overflow-hidden border border-black/15 dark:border-white/20">
            <div class="flex items-center justify-between px-4 py-2 bg-neutral-900 dark:bg-neutral-950 border-b border-white/10">
              <span class="font-mono text-xs text-neutral-400">psi_monitor.py</span>
              <span class="font-mono text-[11px] text-neutral-500">python</span>
            </div>
            <pre class="p-4 overflow-x-auto bg-neutral-900 dark:bg-neutral-950 text-[12.5px] md:text-[13px] leading-6 font-mono text-neutral-200"><code><span class="text-purple-400">def</span> <span class="text-blue-400">psi</span>(expected, actual, bins=<span class="text-amber-300">10</span>, eps=<span class="text-amber-300">1e-4</span>):
    <span class="text-neutral-500">"""Population Stability Index.
    &lt;0.1 stable · 0.1–0.25 watch · &gt;0.25 investigate."""</span>
    breaks = np.unique(np.quantile(expected, np.linspace(<span class="text-amber-300">0</span>, <span class="text-amber-300">1</span>, bins + <span class="text-amber-300">1</span>)))
    e_counts, _ = np.histogram(expected, bins=breaks)
    a_counts, _ = np.histogram(actual, bins=breaks)
    e_perc = np.clip(e_counts / e_counts.sum(), eps, <span class="text-purple-400">None</span>)
    a_perc = np.clip(a_counts / a_counts.sum(), eps, <span class="text-purple-400">None</span>)
    <span class="text-purple-400">return</span> np.sum((a_perc - e_perc) * np.log(a_perc / e_perc))

<span class="text-neutral-500"># score drift is the canary: decisions move when scores move</span>
<span class="text-blue-400">print</span>(<span class="text-green-300">f"model score  PSI=</span><span class="text-green-300">{</span>psi(score_valid, score_prod):.3f<span class="text-green-300">}</span><span class="text-green-300">"</span>)</code></pre>
          </div>
        </div>
      </section>

      <!-- PROJECTS -->
      <section class="animate">
        <div class="space-y-4">
          <div class="flex justify-between items-baseline">
            <p class="font-semibold text-black dark:text-white">Case studies</p>
            <a href="/projects" class="group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend text-sm">
              <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">All projects</span>
            </a>
          </div>
          <ul class="space-y-4">
            {projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- CURRENTLY -->
      <section class="animate">
        <div class="p-5 rounded-xl border border-black/10 dark:border-white/20 bg-black/[0.02] dark:bg-white/[0.03]">
          <p class="font-mono text-xs uppercase opacity-50 mb-2">Currently</p>
          <p class="text-sm leading-relaxed">
            <b>Model Risk &amp; Validation Engineer</b> at DTCC, working the AI/ML model-risk lifecycle —
            SR 11-7 determination, independent validation, LLM evaluation. Based in Dallas–Fort Worth, TX.
            Writing a 20-note series on validation, quant research, simulation, and embedded systems.
          </p>
          <div class="flex flex-wrap gap-3 mt-4">
            <a href="/about" class="py-2 px-4 rounded truncate text-sm bg-black dark:bg-white text-white dark:text-black hover:opacity-75 blend">About me</a>
            <a href="/resume" class="py-2 px-4 truncate rounded text-sm border border-black/25 dark:border-white/25 hover:bg-black/5 hover:dark:bg-white/15 blend">Resume</a>
          </div>
        </div>
      </section>

      <!-- PROFILES -->
      <section class="animate">
        <div>
          <p class="font-semibold text-black dark:text-white">Find me elsewhere</p>
          <p class="text-sm opacity-75">Code, writing, and professional profiles.</p>
          <div class="grid grid-cols-4 gap-y-2 mt-4 auto-cols-min">
            {SOCIALS.map(social => (
              <div class="col-span-1 flex items-center gap-1">
                <span class="whitespace-nowrap truncate text-sm">{social.NAME}</span>
              </div>
              <div class="col-span-3 truncate">
                <a href={social.HREF} target="_blank" class="w-fit col-span-3 group flex gap-1 items-center underline decoration-[.5px] decoration-black/25 dark:decoration-white/50 hover:decoration-black dark:hover:decoration-white text-black dark:text-white underline-offset-2 blend text-sm">
                  <span class="text-black/75 dark:text-white/75 group-hover:text-black group-hover:dark:text-white blend">{social.TEXT}</span>
                </a>
              </div>
            ))}
          </div>
          <div class="mt-6">
            <a href="mailto:abdulmalikajisegiri@gmail.com" class="inline-block py-2 px-4 rounded truncate text-sm bg-black dark:bg-white text-white dark:text-black hover:opacity-75 blend">
              abdulmalikajisegiri@gmail.com
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>
