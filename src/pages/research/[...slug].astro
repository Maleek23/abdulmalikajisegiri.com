---
import { type CollectionEntry, getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import ArticleTopLayout from "@layouts/ArticleTopLayout.astro"
import ArticleBottomLayout from "@layouts/ArticleBottomLayout.astro"

// Create the static research pages (drafts are excluded from the build)
export async function getStaticPaths() {
	const posts = (await getCollection("research")).filter((post) => !post.data.draft)
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}))
}

// Get the requested post
type Props = CollectionEntry<"research">
const post = Astro.props
const { title, summary } = post.data

const articleSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": summary,
    "author": {
      "@type": "Person",
      "name": "Abdulmalik Ajisegiri",
      "url": "https://abdulmalikajisegiri.com/about",
    },
    "datePublished": post.data.date.toISOString(),
    "dateModified": post.data.date.toISOString(),
    "mainEntityOfPage": `https://abdulmalikajisegiri.com/research/${post.slug}/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://abdulmalikajisegiri.com/" },
      { "@type": "ListItem", "position": 2, "name": "Research", "item": "https://abdulmalikajisegiri.com/research" },
      { "@type": "ListItem", "position": 3, "name": title, "item": `https://abdulmalikajisegiri.com/research/${post.slug}/` },
    ],
  },
]
---

<PageLayout title={title} description={summary} schema={articleSchema}>
  <TopLayout>
    <div class="animate">
      <ArticleTopLayout entry={post}/>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <ArticleBottomLayout entry={post} />
    </div>
  </BottomLayout>
</PageLayout>