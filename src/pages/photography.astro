---
import PageLayout from "@layouts/PageLayout.astro"
import TopLayout from "@layouts/TopLayout.astro"
import BottomLayout from "@layouts/BottomLayout.astro"
import { PHOTOGRAPHY } from "@consts"

// Placeholder tiles until real photography assets are available.
const placeholders = Array.from({ length: 6 }, (_, i) => i)
---

<PageLayout title={PHOTOGRAPHY.TITLE} description={PHOTOGRAPHY.DESCRIPTION} robots="noindex,nofollow">
  <TopLayout>
    <div class="animate">
      <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
        Photography & Film
      </h1>
      <div class="mt-1">
        {PHOTOGRAPHY.DESCRIPTION}
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <article class="animate prose prose-neutral dark:prose-invert max-w-none">
      <p>
        My photography and filmmaking work lives under <strong>Leekshotit</strong> —
        a separate brand and portfolio. A different kind of systems thinking,
        with light instead of models.
      </p>

      <div class="not-prose grid grid-cols-2 sm:grid-cols-3 gap-3 my-6">
        {placeholders.map(() => (
          <div class="aspect-square rounded-lg border border-dashed border-black/20 dark:border-white/25 flex items-center justify-center">
            <span class="text-xs opacity-50">Photo coming soon</span>
          </div>
        ))}
      </div>

      <div class="not-prose my-8 text-center">
        <a href="https://leekshotit.com" target="_blank" class="inline-block py-3 px-6 rounded text-sm bg-black dark:bg-white text-white dark:text-black hover:opacity-75 transition-opacity">
          View the full portfolio at leekshotit.com ↗
        </a>
        <p class="text-sm opacity-75 mt-3">
          Full galleries live on the Leekshotit property — this page is just the doorway.
        </p>
      </div>
    </article>
  </BottomLayout>
</PageLayout>
