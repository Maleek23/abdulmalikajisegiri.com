---
import { SITE, SOCIALS } from "@consts"
---

<footer class="ed-footer">
  <div class="ed-wrap">
    <div class="ed-foot-cta">
      <div>
        <h2>Build something defensible.</h2>
        <p class="sub">Engineering, validation, quantitative research — or just say hello.</p>
      </div>
      <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
        <a class="btn-paper" href="mailto:me@abdulmalikajisegiri.com?subject=Project%20inquiry">Email me <span>&rarr;</span></a>
      </div>
    </div>

    <div class="ed-foot-cols">
      <div>
        <p>SITE</p>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/engineering">Engineering</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/research">Research</a></li>
          <li><a href="/ai-ml">AI / ML</a></li>
          <li><a href="/model-risk">Model Risk</a></li>
          <li><a href="/mbse">MBSE</a></li>
          <li><a href="/systems-engineering">Systems Engineering</a></li>
          <li><a href="/quant">Quant</a></li>
          <li><a href="/photography">Photography</a></li>
          <li><a href="/resume">Resume</a></li>
          <li><a href="/now">Now</a></li>
        </ul>
      </div>
      <div>
        <p>PROPERTIES</p>
        <ul>
          <li><span style="opacity:.6;">Quant Edge <em style="font-size:12px;">(soon)</em></span></li>
          <li><a href="https://leekshotit.com" target="_blank" rel="noopener">Leekshotit &#8599;</a></li>
          <li><a href="https://github.com/Maleek23" target="_blank" rel="noopener">GitHub &#8599;</a></li>
        </ul>
      </div>
      <div>
        <p>PROFILES</p>
        <ul>
          <li><a href="https://github.com/Maleek23" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="mailto:me@abdulmalikajisegiri.com">Email</a></li>
        </ul>
      </div>
      <div>
        <p>CONTACT</p>
        <ul>
          <li><a href="/contact">Contact page</a></li>
          <li><a href="mailto:me@abdulmalikajisegiri.com">me@abdulmalikajisegiri.com</a></li>
        </ul>
      </div>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;padding:0 0 40px;">
      <button id="back-to-top" aria-label="Back to top of page" class="btn-ghost" style="color:#f4f2ea;border-color:rgba(244,242,234,.5);padding:10px 20px;font-size:14px;">
        &uarr; Back to top
      </button>
      <div style="display:flex;gap:10px;align-items:center;">
        {
          SOCIALS.map((SOCIAL) => (
            <a
              href={SOCIAL.HREF}
              target="_blank"
              rel="noopener"
              aria-label={`${SITE.TITLE} on ${SOCIAL.NAME}`}
              class="ed-icon-btn"
              style="border-color:rgba(244,242,234,.5);color:#f4f2ea;"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <use href={`/social.svg#${SOCIAL.ICON}`} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="ed-foot-bar">
    <div class="ed-wrap">
      <span>ABDULMALIK AJISEGIRI</span>
      <span style="display:flex;gap:22px;">
        <a href="/legal/terms">Terms</a>
        <a href="/legal/privacy">Privacy</a>
        <span>&copy; 2026</span>
      </span>
    </div>
  </div>
</footer>

<script is:inline>
  function goBackToTop(event) {
    event.preventDefault()
    window.scrollTo({ top: 0, behavior: "smooth" })
  }

  function initializeBackToTop() {
    const backToTop = document.getElementById("back-to-top")
    backToTop?.addEventListener("click", goBackToTop)
  }

  document.addEventListener("astro:after-swap", initializeBackToTop)
  initializeBackToTop()
</script>
