---
import { SITE, LINKS } from "@consts"
import { cn } from "@lib/utils"
const { pathname } = Astro.url
const subpath = pathname.match(/[^/]+/g)
---

<header id="header" class="ed-header">
  <div class="ed-wrap" style="display:flex;align-items:center;justify-content:space-between;height:64px;">
    <a class="ed-brand" href="/" aria-label={`${SITE.TITLE} — home`}>
      <span class="dot"></span>
      <span>ENGINEERING&nbsp;PRACTICE</span>
    </a>

    <nav class="ed-nav hidden md:flex items-center gap-0.5" aria-label="Primary">
      {
        LINKS.map((LINK) => (
          <a
            href={LINK.HREF}
            class={cn(pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF ? "active" : "")}
            aria-current={pathname === LINK.HREF || "/" + subpath?.[0] === LINK.HREF ? "page" : undefined}
          >
            {LINK.TEXT}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/search" aria-label={`Search research articles and projects on ${SITE.TITLE}`} class={cn("ed-icon-btn hidden md:inline-flex", pathname === "/search" || "/" + subpath?.[0] === "/search" ? "pointer-events-none" : "")} style={pathname === "/search" || "/" + subpath?.[0] === "/search" ? "background:var(--green-soft);color:var(--green);border-color:var(--green);" : ""}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
          <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
        </svg>
      </a>

      <a href="/rss.xml" target="_blank" aria-label={`RSS feed for ${SITE.TITLE}`} class="ed-icon-btn hidden md:inline-flex">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
          <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/>
        </svg>
      </a>

      <button id="header-theme-button" aria-label="Toggle light and dark theme" class="ed-icon-btn hidden md:inline-flex" type="button">
        <svg class="block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
        <svg class="hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
      </button>

      <button id="header-drawer-button" aria-label="Toggle drawer open and closed" class="ed-icon-btn md:hidden" type="button">
        <svg id="drawer-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
          <path d="M3 6h18M3 12h18M3 18h18"/>
        </svg>
        <svg id="drawer-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" style="display:none">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  #header-drawer-button.open > #drawer-open {
    display: none;
  }

  #header-drawer-button.open > #drawer-close {
    display: block;
  }
</style>

<script is:inline>
  function toggleDrawer() {
    const drawer = document.getElementById("drawer")
    const drawerButton = document.getElementById("header-drawer-button")
    drawer?.classList.toggle("open")
    drawerButton?.classList.toggle("open")
  }

  function initializeDrawerButton() {
    const drawerButton = document.getElementById("header-drawer-button")
    drawerButton?.addEventListener("click", toggleDrawer)
  }

  document.addEventListener("astro:after-swap", initializeDrawerButton)
  initializeDrawerButton()
</script>
