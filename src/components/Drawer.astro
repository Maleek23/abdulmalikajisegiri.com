---
import { SITE, NAV_MAIN, NAV_MORE } from "@consts"
import { cn } from "@lib/utils"
const { pathname } = Astro.url
const subpath = pathname.match(/[^/]+/g)
const isActive = (href: string) => pathname === href || "/" + subpath?.[0] === href

const groups = [
  { label: "WORK", links: NAV_MAIN.filter((l) => l.HREF !== "/about") },
  { label: "PROFILE", links: [
    ...NAV_MAIN.filter((l) => l.HREF === "/about"),
    ...NAV_MORE.filter((l) => l.HREF === "/resume" || l.HREF === "/contact"),
  ]},
  { label: "ELSEWHERE", links: NAV_MORE.filter((l) => ["/ai-ml", "/model-risk", "/mbse", "/systems-engineering", "/quant", "/photography"].includes(l.HREF)) },
]
let idx = 0
---

<div id="drawer" class="fixed inset-0 h-0 z-40 overflow-hidden flex flex-col md:hidden transition-[height] duration-300 ease-in-out" style="background:var(--paper);">
  <div class="drawer-inner">
    <a href="/hire" class="btn-solid drawer-cta" style={`--d:${idx++}`}>Hire me &rarr;</a>

    <nav class="drawer-groups" aria-label="Mobile">
      {
        groups.map((group) => (
          <div class="drawer-group" style={`--d:${idx++}`}>
            <p class="drawer-label">{group.label}</p>
            {
              group.links.map((LINK) => (
                <a
                  href={LINK.HREF}
                  class={cn("drawer-link", isActive(LINK.HREF) ? "active" : "")}
                  aria-current={isActive(LINK.HREF) ? "page" : undefined}
                >
                  <span class="drawer-link-text">{LINK.TEXT}</span>
                  <span class="drawer-link-arrow" aria-hidden="true">&rarr;</span>
                </a>
              ))
            }
          </div>
        ))
      }
    </nav>

    <div class="drawer-foot" style={`--d:${idx++}`}>
      <a href="mailto:abdulmalikajisegiri@gmail.com" class="drawer-mail">abdulmalikajisegiri@gmail.com</a>
      <div class="flex gap-2 mt-4 justify-center">
        <a href="/search" aria-label={`Search research articles and projects on ${SITE.TITLE}`} class="ed-icon-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>
          </svg>
        </a>
        <a href="/rss.xml" target="_blank" aria-label={`RSS feed for ${SITE.TITLE}`} class="ed-icon-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <button id="drawer-theme-button" aria-label="Toggle light and dark theme" class="ed-icon-btn" type="button">
          <svg class="block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
          </svg>
          <svg class="hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  #drawer.open {
    @apply h-full;
  }
  .drawer-inner {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    padding: 84px 28px 40px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .drawer-cta {
    text-align: center;
    font-size: 16px;
    padding: 14px 20px;
  }
  .drawer-groups {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .drawer-label {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .drawer-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 21px;
    font-weight: 600;
  }
  .drawer-link-arrow {
    color: var(--green);
    font-size: 16px;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.15s, transform 0.15s;
  }
  .drawer-link:hover .drawer-link-arrow,
  .drawer-link:active .drawer-link-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .drawer-link.active {
    color: var(--green);
  }
  .drawer-link.active .drawer-link-arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .drawer-foot {
    text-align: center;
    padding-top: 8px;
  }
  .drawer-mail {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--green);
    text-decoration: none;
    word-break: break-all;
  }
  /* Staggered entrance */
  #drawer .drawer-cta,
  #drawer .drawer-group,
  #drawer .drawer-foot {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    transition-delay: 0s;
  }
  #drawer.open .drawer-cta,
  #drawer.open .drawer-group,
  #drawer.open .drawer-foot {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--d, 0) * 55ms + 80ms);
  }
</style>
